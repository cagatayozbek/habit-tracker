{
  "expo": {
    "name": "Habit Tracker",
    "slug": "habit-tracker",
    "scheme": "habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-production.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-production.png",
          "color": "#32694F"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173B2D",
          "image": "./assets/splash-production.png",
          "imageWidth": 210,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
